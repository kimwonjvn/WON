<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WON_Setup.exe — one-file installer. It needs no administrator approval and no certificate: the app is
    installed into the user's own profile (%LOCALAPPDATA%\Programs\WON), like Chrome or VS Code do.
    .NET Framework 4.7.2 ships with Windows 10 1809+/11, so users need nothing else installed.
    Build with tools\build-installer.ps1, which passes the payload (a zip of the published app) and the uninstaller:
      -p:PayloadZip=...  -p:PayloadUninstall=...  -p:AppVersion=x.y.z
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WON_Setup</AssemblyName>
    <RootNamespace>WonSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Span\Span\Assets\app.ico</ApplicationIcon>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <Version>$(AppVersion)</Version>
    <Company>WON</Company>
    <Product>WON</Product>
    <Description>WON installer</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Span\Span\Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != ''" />
    <EmbeddedResource Include="$(PayloadUninstall)" LogicalName="uninstall.exe" Condition="'$(PayloadUninstall)' != ''" />
  </ItemGroup>

  <Target Name="RequirePayload" BeforeTargets="CoreCompile">
    <Error Condition="'$(PayloadZip)' == '' Or '$(PayloadUninstall)' == ''"
           Text="Pass -p:PayloadZip and -p:PayloadUninstall (use tools\build-installer.ps1)." />
  </Target>

</Project>
